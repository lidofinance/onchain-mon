bin

# Dependency directories (remove the comment below to include it)
# vendor/

vendor/
tools/vendor

notification.yaml
notification.prod.yaml
notification.temp.yaml
# infra/ holds both config (tracked) and runtime state (ignored).
# Ignore everything, then re-add the files that describe the local stack.
infra/*
!infra/nats/
infra/nats/*
!infra/nats/nats.conf
!infra/prometheus/
!infra/grafana/
# The dashboard lives in the ansible repo — this copy is a local working file.
infra/grafana/dashboards/*.json
